# ─────────────────────────────────────────────────────────────
# Aegis Supply Chain Agent — Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# ─────────────────────────────────────────────────────────────

# Choose which LLM backend to use: gemini | openai | groq
ACTIVE_LLM=gemini

# Google Gemini API key (required if ACTIVE_LLM=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API key (required if ACTIVE_LLM=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API key (required if ACTIVE_LLM=groq)
GROQ_API_KEY=your_groq_api_key_here
